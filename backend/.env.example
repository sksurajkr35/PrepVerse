# Copy to .env and fill in. NEVER commit real secrets.
MYSQL_PASSWORD=root
# Generate a strong one:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-in-production
# Optional: live AI mentor answers (blank = built-in fallback replies)
GEMINI_API_KEY=
# Comma-separated frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
MYSQL_USER=root
